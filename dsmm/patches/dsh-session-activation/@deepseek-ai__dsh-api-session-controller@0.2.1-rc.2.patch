+    }
+    rotate() {
+        const old = this.generation;
+        this.generation = this.nextGeneration();
+        old.abort.abort(this.refusal());
+    }
+    refusal() {
+        return new RemoteError('session/history-unavailable', 'Protected history readiness is unavailable or has changed.', {});
+    }
+    register(guard) {
+        guard.signal.throwIfAborted();
+        if (this.closed) throw this.refusal();
+        const entry = { guard, remove: undefined };
+        const remove = () => {
+            guard.signal.removeEventListener('abort', remove);
+            if (this.guards.delete(entry)) this.rotate();
+        };
+        entry.remove = remove;
+        this.guards.add(entry);
+        guard.signal.addEventListener('abort', remove, { once: true });
+        this.rotate();
+        return remove;
+    }
