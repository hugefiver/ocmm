+import type { Context } from '@deepseek-ai/cordis';
+import type { Agent, ResumeAgentOptions } from '@deepseek-ai/dsh-agent';
+import type { SessionId } from '@deepseek-ai/dsh-session';
+import type { SessionPersistence, SessionWriteInspection } from '@deepseek-ai/dsh-session-persistence';
+export type SessionActivationFailure = 'authorization-required' | 'stale' | 'cancelled' | 'unsupported-backend' | 'initializing';
+export declare class SessionActivationError extends Error {
+    readonly category: SessionActivationFailure;
+    constructor(category: SessionActivationFailure, message: string);
+}
+export interface SessionActivationRequest {
+    readonly processPending: boolean;
+    readonly identity: object;
+    readonly owner: Context;
+    readonly persistence: SessionPersistence;
+    readonly sessionId: SessionId;
+    readonly parentAgent: Agent | undefined;
+    readonly options: ResumeActivationOptions;
+    readonly setup: ResumeAgentOptions['setup'];
+    readonly signal: AbortSignal;
+}
+export interface ResumeActivationOptions extends ResumeAgentOptions {
+    /** Wake the existing inbox after final admission and all created notifications; no replay or reinsertion. */
+    readonly processPending?: boolean;
+}
+/** All checks are synchronous and throw to veto. Disposal revokes only this operation. */
+export interface SessionActivationAdmission {
+    assertCurrent(): undefined;
+    validateLoaded(inspection: SessionWriteInspection): undefined;
+    validatePublish(agent: Agent): undefined;
+    dispose(): undefined;
+}
+export type SessionActivationGuard = (request: SessionActivationRequest) => SessionActivationAdmission | Promise<SessionActivationAdmission>;
+export interface SessionActivationState {
+    readonly phase: 'initializing' | 'committed';
+    readonly request: SessionActivationRequest;
+    readonly agent?: Agent;
+}
