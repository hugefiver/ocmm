+        const bound = Function.prototype.bind.call(this, receiver);
+        adapters.set(bound, true);
+        return bound;
+    } });
+    return listener;
+}
+export async function dispatchApproval(target, event, request, delivery, inner) {
+    if (delivery) deliveries.set(request, Object.freeze({ ...delivery }));
+    const callbacks = target.events.dispatch('waterfall', [target, event, request]);
+    let cursor = 0, winner;
+    const invoke = () => {
