FROM rust:1-bookworm AS lsp-builder
WORKDIR /workspace
COPY Cargo.toml Cargo.lock ./
COPY crates/ocmm-lsp ./crates/ocmm-lsp
RUN cargo build --release -p ocmm-lsp

FROM node:22-bookworm-slim

ARG DSH_PACKAGE=@deepseek-ai/dsh@0.1.1-rc.2
WORKDIR /workspace

COPY --from=lsp-builder /workspace/target/release/ocmm-lsp /usr/local/bin/ocmm-lsp
COPY dsmm ./dsmm
COPY LICENSE ./LICENSE

RUN corepack enable && corepack prepare pnpm@11.9.0 --activate
RUN printf "packages:\n  - dsmm\nautoInstallPeers: false\n" > pnpm-workspace.yaml
RUN cd dsmm && pnpm install --ignore-scripts && pnpm run build
RUN npm install -g ${DSH_PACKAGE}

ENV DSMM_DOCKER_INNER=1
CMD ["node", "dsmm/scripts/docker-smoke.mjs"]
